{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocalab.local/schemas/theory-document.json",
  "title": "RuleLab Theory Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "folderId", "title", "blocks", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "folderId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "maxLength": 200 },
    "blocks": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/block" } },
    "createdAt": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 20000 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "fontFamily": { "enum": ["sans", "serif", "mono"] },
        "fontSize": { "enum": ["small", "normal", "large"] },
        "color": { "type": "string", "pattern": "^[a-z-]+$" },
        "highlight": { "type": "string", "pattern": "^[a-z-]+$" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["title", "subtitle", "paragraph", "rule", "example", "exception", "tip", "bulleted-list", "numbered-list", "divider"] },
        "align": { "enum": ["left", "center", "right"] },
        "fontFamily": { "enum": ["sans", "serif", "mono"] },
        "fontSize": { "enum": ["small", "normal", "large"] },
        "segments": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/run" } },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "array", "items": { "$ref": "#/$defs/run" } }
        }
      }
    }
  }
}
