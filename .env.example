# =============================================================================
# SERVER SECRETS AND SUPABASE
# Never expose these values with the NEXT_PUBLIC_ prefix.
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SYNC_CODE_PEPPER=replace_with_at_least_32_random_characters

# =============================================================================
# AUTOMATIC SYNCHRONIZATION
# One table per Lab. SUPABASE_SYNC_TABLE is retained for legacy backups.
# =============================================================================
SUPABASE_SYNC_TABLE=vocablab_sync_state
SUPABASE_SYNC_CLAIMS_TABLE=vocablab_sync_claims
SUPABASE_SYNC_GENERAL_TABLE=vocablab_sync_general
SUPABASE_SYNC_VOCAB_TABLE=vocablab_sync_vocab
SUPABASE_SYNC_REGENCY_TABLE=vocablab_sync_regency
SUPABASE_SYNC_RULE_TABLE=vocablab_sync_rule
SUPABASE_SYNC_READ_TABLE=vocablab_sync_read
SUPABASE_SYNC_QUESTION_TABLE=vocablab_sync_question

# =============================================================================
# GRANITE AUTOMATIC FAILOVER
# The backup activates after consecutive responses exceed both thresholds.
# =============================================================================
GRANITE_BACKUP_MODEL=sao10k/l3-lunaris-8b
GRANITE_HIGH_LATENCY_MS=8000
GRANITE_LOW_TOKENS_PER_SECOND=8
GRANITE_DEGRADED_SAMPLES=2
GRANITE_FAILOVER_COOLDOWN_MS=300000

# =============================================================================
# VOCABLAB
# =============================================================================
DEFAULT_AI_MODEL=openai/gpt-5.4-nano
NEXT_PUBLIC_DEFAULT_AI_MODEL=openai/gpt-5.4-nano
PREDICT_AI_MODEL=openai/gpt-5.4-nano
LEXICOGRAPHER_REVIEW_AI_MODEL=openai/gpt-5.4-nano
DERIVATION_AI_MODEL=openai/gpt-5.4-nano
VALIDATE_DERIVATIONS_AI_MODEL=z-ai/glm-4.7-flash

# =============================================================================
# REGENCYLAB
# =============================================================================
REGENCY_AI_MODEL=google/gemini-3.1-flash-lite
REGENCY_GENERATOR_FALLBACK_MODEL=ibm-granite/granite-4.1-8b
REGENCY_REVIEW_AI_MODEL=openai/gpt-5.4-nano

# =============================================================================
# READLAB
# Lookup fallback: READLAB_LOOKUP_AI_MODEL -> READLAB_AI_MODEL -> DEFAULT_AI_MODEL
# =============================================================================
READLAB_AI_MODEL=ibm-granite/granite-4.1-8b
READLAB_LOOKUP_AI_MODEL=google/gemini-3.1-flash-lite
READLAB_OCR_MODEL=google/gemini-3-flash-preview

# =============================================================================
# QUESTIONLAB
# =============================================================================
GRAMMAR_AI_MODEL=openai/gpt-5.4-nano
REVISOR_AI_MODEL=openai/gpt-5.4-nano

# =============================================================================
# PDF IMPORT AND REVIEW
# OCR models must support vision.
# =============================================================================
QUIZLET_IMPORT_OCR_MODEL=google/gemini-3.1-flash-lite
QUIZLET_IMPORT_REVIEW_AI_MODEL=ibm-granite/granite-4.1-8b

# =============================================================================
# AUDIO
# Both Labs use GPT Audio Mini as primary. Supported voices:
# alloy, echo, fable, onyx, nova, shimmer
# =============================================================================
PRONUNCIATION_AI_MODEL=openai/gpt-audio-mini
READLAB_AUDIO_AI_MODEL=openai/gpt-audio-mini
PRONUNCIATION_AI_VOICE=alloy
PRONUNCIATION_AI_FORMAT=pcm16

# =============================================================================
# PUBLIC BROWSER VARIABLES
# These values are safe to expose to the client bundle.
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
